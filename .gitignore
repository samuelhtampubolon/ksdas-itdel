# ==============================================================================
# KSDAS IT DEL - GITIGNORE & REPOSITORY CLEANLINESS
# Author: Samuel Hasudungan Tampubolon
# Protects against leaking secrets, credentials, environment files, or system cache
# ==============================================================================

# Kredensial & Variabel Lingkungan Sensitif
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
*.crt
id_rsa*
secrets/

# Berkas Log & Jejak Debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Berkas Dependensi & Build Cache (Jika Menggunakan Node.js/Python)
node_modules/
.npm/
.yarn/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
dist/
build/
.cache/

# Sistem Operasi & Direktori Editor Lokal
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# Cadangan Lokal & Berkas Sementara
*.bak
*.tmp
*.temp
/scratch/
/tmp/
