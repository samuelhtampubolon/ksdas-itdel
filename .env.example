# ==============================================================================
# KSDAS IT DEL - ENVIRONMENT CONFIGURATION TEMPLATE
# Kerja Sama Data & Analytics System - Institut Teknologi Del
# ==============================================================================

# --- APLIKASI & LINGKUNGAN ---
NODE_ENV=production
APP_PORT=8080
APP_URL=https://<DOMAIN-KSDAS-TBD>
APP_SECRET=<ISI-DARI-SECRET-MANAGER>

# --- BASIS DATA POSTGRESQL (SDI/TSI Server) ---
DB_HOST=ksdas-db
DB_PORT=5432
DB_NAME=ksdas_db
DB_USER=ksdas_app
DB_PASSWORD=<ISI-DARI-SECRET-MANAGER>
DB_SSL=false

# --- OBJECT STORAGE (MINIO / S3 KAMPUS) ---
S3_ENDPOINT=ksdas-storage
S3_PORT=9000
S3_USE_SSL=false
S3_ACCESS_KEY=ksdas_minio_admin
S3_SECRET_KEY=<ISI-DARI-SECRET-MANAGER>
S3_BUCKET_DOCUMENTS=ksdas-documents
S3_BUCKET_EVIDENCES=ksdas-evidences

# --- AUTENTIKASI SINGLE SIGN-ON (SSO IT DEL) ---
SSO_ENABLED=true
SSO_PROVIDER=keycloak # Opsi: keycloak / cas / oauth2
SSO_ISSUER_URL=https://<IDP-KAMPUS-TBD>/auth/realms/itdel
SSO_CLIENT_ID=ksdas-client
SSO_CLIENT_SECRET=<ISI-DARI-SECRET-MANAGER>
SSO_CALLBACK_URL=https://<DOMAIN-KSDAS-TBD>/api/v1/auth/callback

# --- OCR & WORKER EKSTRAKSI ---
OCR_ENGINE=tesseract # Opsi: tesseract / campus_ai_worker
TESSERACT_LANG=ind+eng
MAX_UPLOAD_SIZE_MB=25
ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# --- PUSAT PEMBERITAHUAN (EMAIL / WA GATEWAY KAMPUS) ---
SMTP_HOST=mail.del.ac.id
SMTP_PORT=587
SMTP_USER=notifikasi.kerjasama@del.ac.id
SMTP_PASS=<ISI-DARI-SECRET-MANAGER>
SMTP_FROM="Unit Kerja Sama IT Del <notifikasi.kerjasama@del.ac.id>"

# --- KEAMANAN & PENCEGAHAN BAHAYA ---
CORS_ORIGIN=<ORIGIN-HTTPS-RESMI-TBD>
CORS_ORIGINS=<ORIGIN-HTTPS-RESMI-TBD>
# Wajib: buat dengan password manager, panjang minimal 32 karakter acak.
# Jangan pernah commit nilai produksinya ke Git.
KSDAS_WRITE_API_KEY=GantiDenganApiKeyAcakPanjangMinimal32Karakter
KSDAS_SERVICE_ACTOR=KSDAS API service
# true hanya untuk demo lokal. Deployment produksi memakai false; endpoint
# /ready akan tetap menolak traffic sampai adapter PostgreSQL dan S3 tersedia.
KSDAS_DEMO_MODE=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
VIRUS_SCAN_ENABLED=true
CLAMAV_HOST=clamav-daemon
CLAMAV_PORT=3310
